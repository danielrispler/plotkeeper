{
  "name": "plotkeeper",
  "version": "0.5.0",
  "description": "Local control room for coding agents (Claude Code, Codex, Cursor, Antigravity CLI) on macOS and Linux that explains what your prompts changed on a live system map",
  "license": "MIT",
  "author": "Daniel Rispler",
  "homepage": "https://github.com/danielrispler/plotkeeper#readme",
  "bugs": {
    "url": "https://github.com/danielrispler/plotkeeper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielrispler/plotkeeper.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "antigravity",
    "agy",
    "copilot",
    "qwen-code",
    "opencode",
    "coding-agents",
    "ai-agents",
    "agent-hooks",
    "claude-code-hooks",
    "system-map",
    "code-review",
    "pr-review",
    "diff",
    "devtools",
    "cli",
    "macos",
    "linux"
  ],
  "os": ["darwin", "linux"],
  "cpu": ["arm64", "x64"],
  "bin": {
    "plotkeeper": "launcher.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "launcher.js"
  ],
  "optionalDependencies": {
    "plotkeeper-darwin": "0.5.0",
    "plotkeeper-linux-x64": "0.5.0",
    "plotkeeper-linux-arm64": "0.5.0"
  }
}
