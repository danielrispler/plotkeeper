{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] },
      { "matcher": "AskUserQuestion|ExitPlanMode", "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-answer\" --agent claude", "timeout": 130, "statusMessage": "Answer in the plotkeeper card" }] }
    ],
    "PermissionDenied": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] },
      { "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-answer\" --agent claude", "timeout": 130, "statusMessage": "Answer in the plotkeeper card" }] }
    ],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "Elicitation": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"__PLOTKEEPER_BIN__/plotkeeper-hook\" --agent claude", "async": true }] }]
  }
}
