{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Unused exports and files (spec #548, Group 3), in `npm run check`. The page's entry is `ui/main.ts`; the node tests
  // reach `ui/` through the `dist/` that `tsc` builds from it.
  "entry": ["ui/main.ts", "ui/tests/*.test.mjs", "scripts/snap/*.mjs", "scripts/review/*.mjs", "scripts/npm/*.mjs", "scripts/agents/*.mjs"],
  "project": ["ui/**/*.{ts,mjs}", "scripts/**/*.{ts,mjs}"],
  // `archive/` is retired code, never built (#332, #415).
  "ignore": ["archive/**"],
  "ignoreIssues": {
    // `ui/types.ts` holds the wire mirrors. Some are imported only by the `scripts/wire/*.ts` files the Rust wire tests
    // write and `tsc -p scripts/wire` checks (#246), which are not there when knip reads the tree.
    "ui/types.ts": ["types"]
  },
  // Commands on Daniel's machine, not npm packages: the installed `plotkeeper`, agy's CLI, and macOS's `sips`.
  "ignoreBinaries": ["plotkeeper", "agy", "sips"]
}
