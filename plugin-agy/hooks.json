{
  "plotkeeper": {
    "SessionStart": [
      {
        "type": "command",
        "command": "p=$(cat); (printf %s \"$p\" | PLOTKEEPER_AGENT_PID=$PPID \"__PLOTKEEPER_HOOK__\" --agent agy >/dev/null 2>&1 &) ; exit 0",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "p=$(cat); (printf %s \"$p\" | PLOTKEEPER_AGENT_PID=$PPID \"__PLOTKEEPER_HOOK__\" --agent agy >/dev/null 2>&1 &) ; exit 0",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "p=$(cat); (printf %s \"$p\" | PLOTKEEPER_AGENT_PID=$PPID \"__PLOTKEEPER_HOOK__\" --agent agy >/dev/null 2>&1 &) ; exit 0",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); (printf %s \"$p\" | PLOTKEEPER_AGENT_PID=$PPID \"__PLOTKEEPER_HOOK__\" --agent agy >/dev/null 2>&1 &) ; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); (printf %s \"$p\" | PLOTKEEPER_AGENT_PID=$PPID \"__PLOTKEEPER_HOOK__\" --agent agy >/dev/null 2>&1 &) ; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "p=$(cat); (printf %s \"$p\" | PLOTKEEPER_AGENT_PID=$PPID \"__PLOTKEEPER_HOOK__\" --agent agy >/dev/null 2>&1 &) ; exit 0",
        "timeout": 5
      }
    ]
  }
}